# Copy this file to .env; never commit .env or API keys.
# Defaults are safe and entirely offline.
AI_LAB_PROVIDER=mock
AI_LAB_MODEL=
APP_REQUEST_TIMEOUT_SECONDS=30

# To use an OpenRouter free model, uncomment these and add OPENROUTER_API_KEY:
# AI_LAB_PROVIDER=openrouter
# AI_LAB_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_API_KEY=

# Other supported providers. Select ONE AI_LAB_PROVIDER and an appropriate AI_LAB_MODEL.
# AI_LAB_PROVIDER=openai
# AI_LAB_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# AI_LAB_PROVIDER=anthropic
# AI_LAB_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=

# AI_LAB_PROVIDER=google
# AI_LAB_MODEL=gemini-3.5-flash
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# AI_LAB_PROVIDER=ollama
# AI_LAB_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional WhyBuddy routing to distinct models on the chosen provider.
# AI_LAB_FAST_MODEL=nvidia/nemotron-3.5-lightning:free
# AI_LAB_DETAILED_MODEL=nvidia/nemotron-3.5-lightning:free

# Phase 6 local playground (never store production keys in frontend code)
# PLAYGROUND_TOKEN=<set a long random token via shell environment for remote access>
# Start offline: uv run --extra playground python -m apps.playground.backend
# Explicit live opt-in: export PLAYGROUND_TOKEN=<long random value>; ... --allow-live
